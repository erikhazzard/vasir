{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "enum": [
        "CLEAR",
        "PARTIAL",
        "OCCLUDED",
        "INFERRED_FROM_DISPLAY_CHANGE"
      ]
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "statement",
    "evidence_ids",
    "actors",
    "visibility",
    "ambiguities"
  ],
  "title": "Neutral gameplay observation"
}
