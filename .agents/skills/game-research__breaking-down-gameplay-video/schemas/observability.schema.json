{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observability.schema.json",
  "title": "Gameplay-video observability and capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "source_ids",
    "topology",
    "activated_adapters",
    "clock_domains",
    "coordinate_spaces",
    "capabilities",
    "instruments",
    "capture_limitations",
    "confidence_ceilings"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "route": {
      "enum": [
        "FULL_RECONSTRUCTION",
        "SYSTEMS_RECONSTRUCTION",
        "FEEL_FORENSICS",
        "PLAYER_REVIEW",
        "COMPARATIVE",
        "FOCUSED"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["camera", "time", "control", "information", "session"],
      "properties": {
        "camera": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FIRST_PERSON", "OVER_SHOULDER", "CENTER_LOCKED_PLAYER", "SIDE_SCROLL",
              "FIXED_ROOM", "FREE_ORBIT", "ISOMETRIC_FOLLOW", "RTS_FREE_MAP",
              "SPECTATOR", "CINEMATIC", "HEAD_TRACKED_XR", "MIXED", "UNKNOWN"
            ]
          }
        },
        "time": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CONTINUOUS_REALTIME", "PAUSABLE_REALTIME", "TURN_BASED", "ROUND_BASED",
              "WAVE_BASED", "LEVEL_BASED", "EDITED_DISCONTINUOUS", "MIXED"
            ]
          }
        },
        "control": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "INPUT_VISIBLE_SYNCHRONIZED", "INPUT_VISIBLE_UNCALIBRATED",
              "ACTION_INFERRED_FROM_OUTPUT", "AI_CONTROLLED", "MULTIPLE_CONTROLLERS",
              "HEAD_HAND_TRACKED_PARTIAL", "UNKNOWN"
            ]
          }
        },
        "information": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FULL_VISIBLE_STATE", "HUD_PARTIAL", "HIDDEN_INFORMATION", "FOG_OF_WAR",
              "OFFSCREEN_SYSTEMS", "COMBAT_LOG_VISIBLE", "COMMENTARY_PRESENT",
              "SUBTITLES_PRESENT", "MULTI_VIEWPORT", "UNKNOWN"
            ]
          }
        },
        "session": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SINGLE_RUN", "REPEATED_ATTEMPTS", "MATCH", "TUTORIAL", "CAMPAIGN_SLICE",
              "BENCHMARK", "MONTAGE", "STREAM", "REPLAY", "SPECTATOR_VOD", "MIXED"
            ]
          }
        }
      }
    },
    "activated_adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "clock_domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "basis", "pause_behavior", "quality"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
          "basis": {"type": "string"},
          "pause_behavior": {"enum": ["ADVANCES", "STOPS", "CONDITIONAL", "UNKNOWN"]},
          "quality": {"enum": ["SUPPORTED", "BOUNDED_HYPOTHESIS", "UNSUPPORTED_BY_CAPTURE"]}
        }
      }
    },
    "coordinate_spaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "unit", "origin", "axes", "mapping_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
          "unit": {"type": "string"},
          "origin": {"type": "string"},
          "axes": {"type": "string"},
          "mapping_status": {"enum": ["SUPPORTED", "BOUNDED_HYPOTHESIS", "UNAVAILABLE"]}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analysis", "status", "required_signal", "reason"],
        "properties": {
          "analysis": {"type": "string"},
          "status": {
            "enum": ["SUPPORTED", "BOUNDED_HYPOTHESIS", "UNSUPPORTED_BY_CAPTURE", "INVALID_FOR_TOPOLOGY"]
          },
          "required_signal": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["VALID", "VALID_WITH_LIMITATIONS", "INVALID_FOR_TOPOLOGY", "UNAVAILABLE", "NOT_REQUIRED"]},
          "reason": {"type": "string"}
        }
      }
    },
    "capture_limitations": {"type": "array", "items": {"type": "string"}},
    "confidence_ceilings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_class", "ceiling", "reason"],
        "properties": {
          "claim_class": {"type": "string"},
          "ceiling": {"enum": ["SUPPORTED", "BOUNDED_HYPOTHESIS", "UNSUPPORTED"]},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
