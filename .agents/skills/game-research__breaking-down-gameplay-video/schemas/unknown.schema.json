{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unknown.schema.json",
  "title": "Typed analytical unknown",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "question",
    "type",
    "evidence_ids",
    "claim_ids",
    "what_is_known",
    "what_is_not_known",
    "baseline_resolution",
    "risk"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "question": {
      "type": "string"
    },
    "type": {
      "enum": [
        "UNOBSERVED",
        "INSUFFICIENT_OPPORTUNITIES",
        "MEASUREMENT_LIMITED",
        "DETECTOR_LIMITED",
        "CONFLICTED",
        "OBSERVATIONALLY_EQUIVALENT",
        "OUT_OF_SCOPE",
        "EXTERNALLY_RESOLVABLE",
        "ADDITIONAL_FOOTAGE_RESOLVABLE",
        "UNIDENTIFIABLE"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    },
    "what_is_known": {
      "type": "string"
    },
    "what_is_not_known": {
      "type": "string"
    },
    "baseline_resolution": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    }
  }
}
