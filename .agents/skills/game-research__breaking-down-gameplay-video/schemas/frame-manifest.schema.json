{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frame-manifest.schema.json",
  "title": "PTS-bearing extracted frame manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "source_sha256",
    "source_path",
    "sampling",
    "transform",
    "format",
    "frames",
    "tool"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "source_path": {
      "type": "string"
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_interval_s",
        "requested_start_s",
        "requested_duration_s",
        "actual_first_pts_s",
        "actual_last_pts_s"
      ],
      "properties": {
        "requested_interval_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "requested_start_s": {
          "type": "number",
          "minimum": 0
        },
        "requested_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "actual_first_pts_s": {
          "type": "number",
          "minimum": 0
        },
        "actual_last_pts_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": true
    },
    "format": {
      "enum": [
        "jpg",
        "png"
      ]
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "path",
          "pts_s",
          "sha256",
          "width",
          "height"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string"
          },
          "pts_s": {
            "type": "number",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "version",
        "command",
        "created_at"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_at": {
          "type": "string"
        }
      }
    }
  }
}
