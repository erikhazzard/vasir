{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "measurand": {
      "type": "string",
      "minLength": 1
    },
    "estimate": {},
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "clock_domain": {
      "type": "string",
      "minLength": 1
    },
    "coordinate_space": {
      "type": [
        "string",
        "null"
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "observation_count": {
      "type": "integer",
      "minimum": 1
    },
    "run_count": {
      "type": "integer",
      "minimum": 1
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "POINT",
            "RANGE",
            "PLUS_MINUS",
            "DISTRIBUTION",
            "BOUND_ONLY",
            "MEASUREMENT",
            "SAMPLING",
            "MODEL",
            "CAPTURE"
          ]
        },
        "low": {
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "plus_minus": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "confidence_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "distribution": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "Validity conditions: version, mode, actor, state, interval, camera segment, difficulty, and value range."
    },
    "invalidating_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "measurand",
    "estimate",
    "unit",
    "clock_domain",
    "coordinate_space",
    "method",
    "parameters",
    "evidence_ids",
    "observation_count",
    "run_count",
    "uncertainty",
    "scope",
    "invalidating_conditions"
  ],
  "title": "Gameplay measurement"
}
