{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "timeline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "timeline_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "source_start_s": {
            "type": "number",
            "minimum": 0
          },
          "source_end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "session_start_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "session_end_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "gap_status": {
            "enum": [
              "NONE_CONFIRMED",
              "KNOWN",
              "INFERRED",
              "UNKNOWN",
              "NOT_SAME_SESSION"
            ]
          },
          "gap_after_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "gap_uncertainty_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "gap_method": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "segment_id",
          "source_id",
          "source_start_s",
          "source_end_s",
          "session_start_s",
          "session_end_s",
          "gap_status",
          "gap_after_s"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "timeline_id",
    "segments"
  ],
  "title": "Session timeline"
}
