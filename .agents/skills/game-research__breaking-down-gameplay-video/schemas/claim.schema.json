{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "kind": {
      "enum": [
        "VISIBLE_DYNAMIC",
        "MECHANIC_CLAIM",
        "CAUSAL_CLAIM",
        "DESIGN_INTERPRETATION",
        "PLAYER_HYPOTHESIS"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "FOOTAGE",
          "VISIBLE_UI_STATEMENT",
          "EMBEDDED_SPEECH",
          "DETERMINISTIC_INSTRUMENT",
          "ANALYST_DERIVATION",
          "EXTERNAL"
        ]
      },
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "measurement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "validation": {
      "enum": [
        "UNTESTED",
        "SUPPORTED",
        "VALIDATED_WITHIN_SCOPE",
        "CONTRADICTED",
        "OBSERVATIONALLY_EQUIVALENT",
        "UNIDENTIFIABLE_FROM_FOOTAGE"
      ]
    },
    "resolution": {
      "enum": [
        "SOURCE_SETTLED",
        "SOURCE_PROVISIONAL",
        "SOURCE_OPEN",
        "BASELINE_FILLED"
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "POINT",
            "RANGE",
            "PLUS_MINUS",
            "DISTRIBUTION",
            "BOUND_ONLY",
            "MEASUREMENT",
            "SAMPLING",
            "MODEL",
            "CAPTURE"
          ]
        },
        "low": {
          "type": [
            "number",
            "null"
          ]
        },
        "high": {
          "type": [
            "number",
            "null"
          ]
        },
        "plus_minus": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "confidence_level": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        },
        "distribution": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "Validity conditions: version, mode, actor, state, interval, camera segment, difficulty, and value range."
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "opportunity_record": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "definition": {
              "type": "string"
            },
            "opportunities": {
              "type": "integer",
              "minimum": 0
            },
            "occurrences": {
              "type": "integer",
              "minimum": 0
            },
            "coverage_notes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "definition",
            "opportunities",
            "occurrences",
            "coverage_notes"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "SOURCE_MODEL_USED",
            "BASELINE_CHOICE",
            "UNFILLED"
          ]
        },
        "chosen_model_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "chosen_model_id",
        "rationale"
      ]
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "statement",
    "source_kinds",
    "evidence_ids",
    "measurement_ids",
    "validation",
    "resolution",
    "uncertainty",
    "scope",
    "alternatives",
    "conflicts",
    "opportunity_record",
    "reconstruction"
  ],
  "title": "Gameplay claim"
}
