{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "kind": {
      "enum": [
        "INTERVAL",
        "FRAME",
        "CROP",
        "CLIP",
        "FILM_STRIP",
        "CONTACT_SHEET_CELL",
        "AUDIO_WINDOW",
        "METRIC_WINDOW"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "pts_start_s": {
          "type": "number",
          "minimum": 0
        },
        "pts_end_s": {
          "type": "number",
          "minimum": 0
        },
        "session_start_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "session_end_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "audio_included": {
          "type": "boolean"
        },
        "context_before_s": {
          "type": "number",
          "minimum": 0
        },
        "context_after_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "source_id",
        "pts_start_s",
        "pts_end_s"
      ]
    },
    "crop": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "coordinate_space": {
              "const": "source_display_px"
            },
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "coordinate_space",
            "x",
            "y",
            "width",
            "height"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "mime_type": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "tool",
        "version",
        "command",
        "transforms"
      ]
    },
    "quality": {
      "type": "object",
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "source",
    "artifact",
    "extraction",
    "quality",
    "limitations"
  ],
  "title": "Evidence record"
}
