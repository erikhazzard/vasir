{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Gameplay chronology event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "pts_start_s",
    "pts_end_s",
    "event_type",
    "description",
    "evidence_ids",
    "visible_state_before",
    "visible_state_after",
    "ambiguities"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "pts_start_s": {
      "type": "number",
      "minimum": 0
    },
    "pts_end_s": {
      "type": "number",
      "minimum": 0
    },
    "session_start_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "session_end_s": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "event_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    },
    "visible_state_before": {
      "type": [
        "object",
        "null"
      ]
    },
    "visible_state_after": {
      "type": [
        "object",
        "null"
      ]
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
