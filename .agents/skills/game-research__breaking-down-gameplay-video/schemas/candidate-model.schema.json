{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "target_claim_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    },
    "kind": {
      "enum": [
        "FORMULA",
        "STATE_MACHINE",
        "TABLE",
        "RANDOM_PROCESS",
        "CAUSAL_GRAPH",
        "HEURISTIC",
        "GEOMETRIC_MODEL",
        "TIMING_MODEL"
      ]
    },
    "description": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "domain": {}
        },
        "required": [
          "name",
          "unit"
        ]
      }
    },
    "model": {
      "type": "object"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "event_or_fixture_id": {
            "type": "string"
          },
          "expected": {},
          "observed": {},
          "result": {
            "enum": [
              "SUPPORT",
              "CONTRADICT",
              "INCONCLUSIVE",
              "NOT_OBSERVED"
            ]
          }
        },
        "required": [
          "event_or_fixture_id",
          "expected",
          "observed",
          "result"
        ]
      }
    },
    "supporting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "contradicting_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hidden_variables": {
          "type": "integer",
          "minimum": 0
        },
        "special_cases": {
          "type": "integer",
          "minimum": 0
        },
        "rationale": {
          "type": "string"
        }
      },
      "required": [
        "hidden_variables",
        "special_cases",
        "rationale"
      ]
    },
    "validation": {
      "enum": [
        "UNTESTED",
        "SUPPORTED",
        "VALIDATED_WITHIN_SCOPE",
        "CONTRADICTED",
        "OBSERVATIONALLY_EQUIVALENT",
        "UNIDENTIFIABLE_FROM_FOOTAGE"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": true,
      "description": "Validity conditions: version, mode, actor, state, interval, camera segment, difficulty, and value range."
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "target_claim_ids",
    "kind",
    "description",
    "assumptions",
    "variables",
    "model",
    "predictions",
    "supporting_evidence_ids",
    "contradicting_evidence_ids",
    "complexity",
    "validation",
    "scope",
    "alternatives"
  ],
  "title": "Candidate hidden-system model"
}
