{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "behavioral-fixtures.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "spec_schema_version": {
      "const": "1.0.0"
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "class": {
            "enum": [
              "REPRODUCTION",
              "BOUNDARY",
              "MODEL_FORK",
              "COMPOSITION",
              "REGRESSION"
            ]
          },
          "purpose": {
            "type": "string"
          },
          "setup": {
            "type": "object"
          },
          "stimulus": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "expected": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "uniqueItems": true
          },
          "tolerance_policy": {
            "type": "object"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "class",
          "purpose",
          "setup",
          "stimulus",
          "expected",
          "evidence_ids",
          "claim_ids",
          "tolerance_policy"
        ]
      }
    },
    "coverage_by_system": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "spec_schema_version",
    "fixtures",
    "coverage_by_system"
  ],
  "title": "Behavioral reconstruction fixtures"
}
