{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-finding.schema.json",
  "title": "Adversarial review finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "gate",
    "severity",
    "affected_object_ids",
    "problem",
    "evidence",
    "proposed_fix",
    "disposition",
    "rationale",
    "changed_artifacts",
    "regression_fixture_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "gate": {
      "enum": [
        "ACQUISITION",
        "INFERENCE",
        "RECONSTRUCTION",
        "PRESENTATION"
      ]
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2"
      ]
    },
    "affected_object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "problem": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_fix": {
      "type": "string"
    },
    "disposition": {
      "enum": [
        "OPEN",
        "FIXED",
        "PARTIALLY_FIXED",
        "DECLINED"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "changed_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regression_fixture_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      }
    }
  }
}
